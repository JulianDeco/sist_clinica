# =============================================================================
# ClinicaSaaS — Variables de entorno
# Copiar a .env y completar todos los valores antes de levantar el stack.
# NUNCA commitear .env con valores reales.
# =============================================================================

# ── Entorno ───────────────────────────────────────────────────────────────────
# dev  → logs DEBUG, SQL en consola, Flyway baseline-on-migrate habilitado
# prod → logs INFO/WARN, sin SQL, Flyway strict
SPRING_PROFILES_ACTIVE=dev

# ── Servidor ──────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USER=clinica_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
DB_NAME=clinica_db

# ── Postgres MCP server (.mcp.json) ─────────────────────────────────────────────
# Cadena de conexión que usa el MCP de Postgres para inspeccionar el esquema.
# Requiere que el contenedor postgres publique el puerto al host
# (agregar `ports: ["5432:5432"]` al servicio postgres en docker-compose.yml).
# Recomendado: un rol de SOLO LECTURA, no el usuario de la app.
# CLINICA_PG_URL=postgresql://readonly_user:PASSWORD@localhost:5432/clinica_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET=REEMPLAZAR_CON_128_CHARS_HEX_ALEATORIOS
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── CORS ──────────────────────────────────────────────────────────────────────
# dev: http://localhost:4200
# prod: https://tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

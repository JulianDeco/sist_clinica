# ── Base de datos ─────────────────────────────────────────────────────────────
DB_USER=clinica_user
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO
DB_NAME=clinica_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=REEMPLAZAR_CON_PASSWORD_SEGURO

# ── JWT / Auth ────────────────────────────────────────────────────────────────
# Mínimo 64 caracteres aleatorios — nunca commitear el valor real
JWT_SECRET=REEMPLAZAR_CON_64_CHARS_ALEATORIOS_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
JWT_ACCESS_EXPIRATION_MS=1800000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Entorno ───────────────────────────────────────────────────────────────────
# Cambiar esta variable para alternar entre entornos:
#   dev  → logs DEBUG, SQL visible en consola, Flyway baseline-on-migrate habilitado
#   prod → logs INFO/WARN solamente, sin SQL, Flyway strict
SPRING_PROFILES_ACTIVE=dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# dev: http://localhost:4200 — prod: https://tudominio.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

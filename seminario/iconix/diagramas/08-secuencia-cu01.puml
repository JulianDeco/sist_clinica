@startuml secuencia_CU01
' =====================================================================
' Diagrama de secuencia ICONIX — CU-01 Reservar turno con validación
' integral
' Entrega T-020 — deliverable 7 · Seminario de Trabajo Final UAI 2026
'
' Fuentes: seminario/iconix/02-especificacion-casos-de-uso.md → CU-01
'          seminario/iconix/diagramas/03-robustez-cu01.puml
' Asignación de comportamiento (control de robustez → clase.método):
'   «Validar disponibilidad de slot»  → DisponibilidadService.validarDisponibilidad()
'   «Sugerir slots alternativos»      → DisponibilidadService.sugerirAlternativas()
'   «Validar cobertura y tope semanal»→ CoberturaService.validarTopeSemanal()
'   «Calcular riesgo de no-show»      → MotorRiesgoNoShowService.calcularRiesgo()
'   «Registrar reserva»               → ReservarTurnoUseCaseImpl.reservar() [@Transactional]
'
' Trazabilidad curso básico → mensajes:
'   Paso 1 → Secretario -> UI «selecciona paciente, profesional y franja»
'   Paso 2 → UI -> CTRL.validarReserva ; UC.validar ;
'            DISP.validarDisponibilidad ; FREPO.buscarPorId ; FRA.estaLibre
'   Paso 3 → COBS.validarTopeSemanal ; CREPO.buscarVigente ;
'            COB.estaVigente ; CREPO.obtenerUsoSemanal
'   Paso 4 → RIESGO.calcularRiesgo ; TREPO.buscarHistorialPaciente ;
'            «create» PrediccionDeRiesgo ; retorno score+factores a UI
'   Paso 5 → Secretario -> UI «confirma» ; UI -> CTRL.confirmarReserva
'   Paso 6 → UC.reservar [@Transactional]: «create» Turno ; FRA.ocupar ;
'            CREPO.incrementarUsoSemanal ; TREPO/FREPO/PREPO.guardar
' Cursos alternos: A1 (alt, CU-S08) · A2 (alt) · A3/A4 (nota) ·
'   A5 (ref → 11-secuencia-cu04.puml)
' Multitenancy (ADR-003): todo método de repositorio recibe tenantId.
' =====================================================================

skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam noteBackgroundColor #FFF8DC

actor "Secretario/a" as Secretario
boundary "ReservaTurnoComponent\n(Angular)" as UI
participant "AgendaController\n«api»" as CTRL
participant "ReservarTurnoUseCaseImpl\n«application»" as UC
participant "DisponibilidadService\n«application»" as DISP
participant "CoberturaService\n«application»" as COBS
participant "MotorRiesgoNoShowService\n«application»" as RIESGO
participant "FranjaHorariaRepository\n«domain·interface»" as FREPO
participant "CoberturaRepository\n«domain·interface»" as CREPO
participant "TurnoRepository\n«domain·interface»" as TREPO
participant "PrediccionRiesgoRepository\n«domain·interface»" as PREPO
entity "FranjaHoraria" as FRA
entity "Cobertura" as COB
entity "Turno" as TUR
entity "PrediccionDeRiesgo" as PRED

== Paso 1 ==
Secretario -> UI : selecciona paciente,\nprofesional y franja horaria

== Paso 2 — CU-S03 Validar disponibilidad de slot ==
UI -> CTRL : POST /api/v1/agenda/reservas/validacion\nvalidarReserva(dto)
CTRL -> UC : validar(comando, tenantId)
UC -> DISP : validarDisponibilidad(franjaId, tenantId)
DISP -> FREPO : buscarPorId(franjaId, tenantId)
FREPO --> DISP : franja
DISP -> FRA : estaLibre()
FRA --> DISP : boolean

alt A1 — franja ya ocupada (CU-S08 Sugerir slots alternativos)
  DISP -> DISP : sugerirAlternativas(profesionalId,\nfecha, tenantId)
  DISP -> FREPO : buscarLibresCercanas(profesionalId,\nfecha, tenantId)
  FREPO --> DISP : List<FranjaHoraria>
  DISP --> UC : ResultadoDisponibilidad(OCUPADA, alternativas)
  UC --> CTRL : alternativas
  CTRL --> UI : 409 Conflict + slots alternativos
  Secretario -> UI : elige un slot alternativo
  note over UI, DISP
    El flujo retoma en el paso 2
    con la nueva franja elegida.
  end note
end
DISP --> UC : ResultadoDisponibilidad(DISPONIBLE)

== Paso 3 — CU-S04 Validar cobertura y tope semanal ==
UC -> COBS : validarTopeSemanal(pacienteId, fecha, tenantId)
COBS -> CREPO : buscarVigente(pacienteId, tenantId)
CREPO --> COBS : cobertura
COBS -> COB : estaVigente(fecha)
COB --> COBS : boolean
COBS -> CREPO : obtenerUsoSemanal(pacienteId, coberturaId,\nsemanaIso, tenantId)
CREPO --> COBS : usoSemanal

alt A2 — cobertura vencida o tope superado
  COBS --> UC : ResultadoCobertura(RECHAZADA, motivo)
  UC --> CTRL : cobertura no válida
  CTRL --> UI : 422 — bloquea reserva con cobertura\ny propone turno particular
  note over UI, COBS
    [A DEFINIR] condiciones de la continuación
    como turno particular (tarifa, registro).
  end note
end
COBS --> UC : ResultadoCobertura(VALIDA)

== Paso 4 — CU-S05 Calcular riesgo de no-show ==
UC -> RIESGO : calcularRiesgo(pacienteId, datosTurno, tenantId)
RIESGO -> TREPO : buscarHistorialPaciente(pacienteId, tenantId)
TREPO --> RIESGO : List<Turno> (historial de asistencia)
RIESGO -> PRED : «create» new PrediccionDeRiesgo(score,\nfactores, confianza, versionModelo)
RIESGO --> UC : prediccion (score 0–100 + factores)
UC --> CTRL : ValidacionReservaResponse(score, factores)
CTRL --> UI : 200 OK
UI --> Secretario : muestra score y factores\nen lenguaje natural

note right of RIESGO
  A3 — paciente sin historial: score con factores
  parciales, confianza = BAJA.
  A4 — falla del motor: degradación elegante — la
  reserva continúa sin score, marcada para reintento.
end note

ref over Secretario, UC
  A5 — score > umbral (70%) y overbooking habilitado:
  se dispara CU-04 «Sugerir overbooking inteligente»
  → ver 11-secuencia-cu04.puml
end ref

== Paso 5 ==
Secretario -> UI : confirma la reserva
UI -> CTRL : POST /api/v1/agenda/reservas\nconfirmarReserva(dto)
CTRL -> UC : reservar(comando, tenantId)

== Paso 6 — transacción atómica (@Transactional) ==
UC -> FREPO : buscarPorId(franjaId, tenantId)\n(re-verifica dentro de la Tx)
FREPO --> UC : franja
UC -> TUR : «create» new Turno(pacienteId, profesionalId,\nfranjaId, estado = RESERVADO)
UC -> FRA : ocupar()
UC -> CREPO : incrementarUsoSemanal(pacienteId,\ncoberturaId, semanaIso, tenantId)
UC -> TREPO : guardar(turno, tenantId)
TREPO --> UC : turnoId
UC -> FREPO : guardar(franja, tenantId)
UC -> PREPO : guardar(prediccion, turnoId, tenantId)

note over UC, PREPO
  Paso 6: Turno, FranjaHoraria, uso de Cobertura y
  PrediccionDeRiesgo se persisten atómicamente en una
  única transacción (@Transactional en el use case).
  El score calculado en el paso 4 viaja en el comando
  de confirmación y se asocia al turno creado.
end note

UC --> CTRL : TurnoCreadoResponse
CTRL --> UI : 201 Created
UI --> Secretario : reserva confirmada

@enduml

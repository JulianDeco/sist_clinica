@startuml 12-clases
' =====================================================================
' Diagrama de clases de diseño ICONIX — ClinicaSaaS (Seminario UAI 2026)
' Entrega T-020 — deliverable 8
'
' Espacio de la SOLUCIÓN.
' Las firmas de métodos provienen de los diagramas de secuencia 08–11.
' La regla de dependencia sigue ADR-010 (Clean Architecture):
'   domain ← application ← api
'   infrastructure implementa interfaces de domain y application.
' =====================================================================

skinparam shadowing false
skinparam classBackgroundColor #FDFDFD
skinparam classBorderColor #555555
skinparam packageBackgroundColor #FAFAFA
skinparam packageBorderColor #AAAAAA
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #CCBB88
skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classAttributeFontSize 11
skinparam packageFontSize 11
skinparam wrapWidth 200
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 60
left to right direction
hide circle

' =====================================================================
' CAPA API
' =====================================================================
package "api" #F0F0FF {

  class AgendaController {
    - reservarTurnoUseCase : ReservarTurnoUseCase
    - sugerirSobreturnoUseCase : SugerirSobreturnoUseCase
    + validarReserva(dto : ValidarReservaRequest) : ValidacionReservaResponse
    + reservarTurno(dto : ReservarTurnoRequest) : TurnoResponse
    + confirmarSobreturno(dto : SobreturnoRequest) : SobreturnoResponse
  }

  class ConsultaController {
    - gestionarConsultaUseCase : GestionarConsultaUseCase
    + abrirConsulta(turnoId : UUID) : ConsultaResponse
    + registrarSOAP(consultaId : UUID, dto : NotaSOAPRequest) : void
    + registrarObservaciones(consultaId : UUID, dto : ObservacionRequest) : void
    + cerrarConsulta(consultaId : UUID) : void
  }

  class TelegramWebhookController {
    - registrarRespuestaUseCase : RegistrarRespuestaUseCase
    + recibirRespuesta(update : TelegramUpdate) : void
  }
}

' =====================================================================
' CAPA APPLICATION
' =====================================================================
package "application" #F0FFF0 {

  interface ReservarTurnoUseCase {
    + validar(cmd : ValidarReservaCmd, tenantId : UUID) : ValidacionResult
    + reservar(cmd : ReservarTurnoCmd, tenantId : UUID) : UUID
  }

  class ReservarTurnoUseCaseImpl {
    - disponibilidadService : DisponibilidadService
    - coberturaService : CoberturaService
    - motorRiesgoService : MotorRiesgoNoShowService
    - turnoRepository : TurnoRepository
    - prediccionRepository : PrediccionRepository
    + validar(cmd : ValidarReservaCmd, tenantId : UUID) : ValidacionResult
    + reservar(cmd : ReservarTurnoCmd, tenantId : UUID) : UUID
  }

  interface SugerirSobreturnoUseCase {
    + evaluar(franjaId : UUID, score : int, tenantId : UUID) : SugerenciaResult
    + crear(cmd : CrearSobreturnoCmd, tenantId : UUID) : UUID
  }

  class SugerirSobreturnoUseCaseImpl {
    - politicaRepository : PoliticaRepository
    - turnoRepository : TurnoRepository
    - franjaRepository : FranjaHorariaRepository
    + evaluar(franjaId : UUID, score : int, tenantId : UUID) : SugerenciaResult
    + crear(cmd : CrearSobreturnoCmd, tenantId : UUID) : UUID
  }

  interface GestionarConsultaUseCase {
    + abrir(turnoId : UUID, tenantId : UUID) : UUID
    + registrarSOAP(consultaId : UUID, nota : NotaSOAP, tenantId : UUID) : void
    + registrarObservaciones(consultaId : UUID, obs : Observacion, tenantId : UUID) : void
    + registrarDiagnostico(consultaId : UUID, texto : String, tenantId : UUID) : void
    + cerrar(consultaId : UUID, tenantId : UUID) : void
  }

  class GestionarConsultaUseCaseImpl {
    - consultaRepository : ConsultaMedicaRepository
    - turnoRepository : TurnoRepository
    - pacienteRepository : PacienteRepository
    + abrir(turnoId : UUID, tenantId : UUID) : UUID
    + registrarSOAP(consultaId : UUID, nota : NotaSOAP, tenantId : UUID) : void
    + registrarObservaciones(consultaId : UUID, obs : Observacion, tenantId : UUID) : void
    + registrarDiagnostico(consultaId : UUID, texto : String, tenantId : UUID) : void
    + cerrar(consultaId : UUID, tenantId : UUID) : void
  }

  interface NotificarPrediccionUseCase {
    + procesar(tenantId : UUID) : void
  }

  class NotificarPrediccionUseCaseImpl {
    - motorRiesgoService : MotorRiesgoNoShowService
    - notificationPort : NotificationPort
    - turnoRepository : TurnoRepository
    - recordatorioRepository : RecordatorioRepository
    - umbralRiesgoAlto : int
    + procesar(tenantId : UUID) : void
    - elegirEstrategia(score : int) : Canal
  }

  interface RegistrarRespuestaUseCase {
    + registrar(turnoId : UUID, respuesta : String, tenantId : UUID) : void
  }

  class RegistrarRespuestaUseCaseImpl {
    - turnoRepository : TurnoRepository
    - recordatorioRepository : RecordatorioRepository
    - franjaRepository : FranjaHorariaRepository
    + registrar(turnoId : UUID, respuesta : String, tenantId : UUID) : void
  }

  class DisponibilidadService {
    - franjaRepository : FranjaHorariaRepository
    + validarDisponibilidad(franjaId : UUID, tenantId : UUID) : ResultadoDisponibilidad
    + sugerirAlternativas(profesId : UUID, fecha : LocalDate, tenantId : UUID) : List<FranjaHoraria>
  }

  class CoberturaService {
    - coberturaRepository : CoberturaRepository
    + validarTopeSemanal(pacienteId : UUID, fecha : LocalDate, tenantId : UUID) : ResultadoCobertura
    + incrementarUso(pacienteId : UUID, cobId : UUID, semana : String, tenantId : UUID) : void
  }

  class MotorRiesgoNoShowService {
    - turnoRepository : TurnoRepository
    - scoreCachePort : ScoreCachePort
    - umbralBajaConfianza : int
    + calcularRiesgo(pacienteId : UUID, datosTurno : DatosTurno, tenantId : UUID) : PrediccionDeRiesgo
    + obtenerScore(turnoId : UUID, tenantId : UUID) : Optional<PrediccionDeRiesgo>
  }

  interface NotificationPort <<port>> {
    + enviar(req : NotificationRequest) : NotificationResult
  }

  interface ScoreCachePort <<port>> {
    + obtener(turnoId : UUID) : Optional<PrediccionDeRiesgo>
    + guardar(turnoId : UUID, pred : PrediccionDeRiesgo, ttl : Duration) : void
  }
}

' =====================================================================
' CAPA DOMAIN
' =====================================================================
package "domain" #FFFDE0 {

  class Turno {
    - id : UUID
    - tenantId : UUID
    - pacienteId : UUID
    - profesionalId : UUID
    - franjaId : UUID
    - estado : EstadoTurno
    - esSobreturno : boolean
    + confirmar() : void
    + cancelar(motivo : String) : void
    + marcarCumplido() : void
  }

  class Sobreturno {
    - motivoOverbooking : String
    - turnoOriginalId : UUID
    + pasarATurnoNormal() : void
  }

  class FranjaHoraria {
    - id : UUID
    - inicio : Instant
    - fin : Instant
    - estado : EstadoFranja
    + estaLibre() : boolean
    + ocupar() : void
    + liberar() : void
    + tieneSobreturno() : boolean
  }

  class Agenda {
    - id : UUID
    - tenantId : UUID
    - profesionalId : UUID
    + franjas() : List<FranjaHoraria>
    + tieneDisponibilidad(fecha : LocalDate) : boolean
  }

  class Paciente {
    - id : UUID
    - nombre : String
    - telefono : String
    - email : String
    + tieneContactoDigital() : boolean
  }

  class Profesional {
    - id : UUID
    - tenantId : UUID
    - nombre : String
    - especialidad : String
    - matricula : String
  }

  class Cobertura {
    - id : UUID
    - vigenciaHasta : LocalDate
    - topeSemanal : int
    + estaVigente(fecha : LocalDate) : boolean
  }

  class ObraSocial {
    - id : UUID
    - nombre : String
    - codigoRNOS : String
  }

  class ConsultaMedica {
    - id : UUID
    - tenantId : UUID
    - turnoId : UUID
    - fechaHoraInicio : Instant
    - fechaHoraCierre : Instant
    - estado : EstadoConsulta
    + documentarSOAP(nota : NotaSOAP) : void
    + registrarObservacion(obs : Observacion) : void
    + finalizar() : void
  }

  class NotaSOAP {
    - subjetivo : String
    - objetivo : String
    - analisis : String
    - plan : String
  }

  class Observacion {
    - codigo : String
    - valor : BigDecimal
    - unidad : String
    + validarRango() : List<String>
  }

  class PrediccionDeRiesgo {
    - id : UUID
    - turnoId : UUID
    - tenantId : UUID
    - score : int
    - confianza : Confianza
    - factores : List<String>
    - versionModelo : String
    - calculadaEn : Instant
    + esRiesgoAlto(umbral : int) : boolean
    + esBajaConfianza() : boolean
  }

  class Recordatorio {
    - id : UUID
    - turnoId : UUID
    - tenantId : UUID
    - canal : Canal
    - estado : EstadoEnvio
    - reintentos : int
    - enviadoEn : Instant
    + registrarRespuesta(resp : String) : void
  }

  class PoliticaDeSobreturnos {
    - habilitado : boolean
    - umbralRiesgo : int
    - topeSemanal : int
    - tiposExcluidos : List<String>
    + permite(tipo : String) : boolean
  }

  enum EstadoTurno {
    RESERVADO
    CONFIRMADO
    LLEGO
    CUMPLIDO
    CANCELADO
    AUSENTE
  }

  enum EstadoConsulta {
    EN_CURSO
    FINALIZADA
  }

  enum EstadoFranja {
    LIBRE
    OCUPADA
    BLOQUEADA
  }

  enum Canal {
    TELEGRAM
    EMAIL
  }

  enum Confianza {
    ALTA
    BAJA
  }

  enum EstadoEnvio {
    PENDIENTE
    ENVIADO
    FALLIDO
    RESPONDIDO
  }

  ' Interfaces de repositorio
  interface TurnoRepository {
    + buscarPorId(id : UUID, tenantId : UUID) : Turno
    + guardar(turno : Turno, tenantId : UUID) : void
    + buscarProximos(ventana : Duration, tenantId : UUID) : List<Turno>
    + contarSobreturnos(profId : UUID, semana : String, tenantId : UUID) : int
  }

  interface FranjaHorariaRepository {
    + buscarPorId(id : UUID, tenantId : UUID) : FranjaHoraria
    + buscarLibresCercanas(profId : UUID, fecha : LocalDate, tenantId : UUID) : List<FranjaHoraria>
    + guardar(franja : FranjaHoraria, tenantId : UUID) : void
  }

  interface CoberturaRepository {
    + buscarVigente(pacId : UUID, tenantId : UUID) : Cobertura
    + obtenerUso(pacId : UUID, cobId : UUID, semana : String, tenantId : UUID) : int
    + incrementarUso(pacId : UUID, cobId : UUID, semana : String, tenantId : UUID) : void
  }

  interface ConsultaMedicaRepository {
    + buscarPorTurno(turnoId : UUID, tenantId : UUID) : Optional<ConsultaMedica>
    + guardar(consulta : ConsultaMedica, tenantId : UUID) : void
  }

  interface PacienteRepository {
    + buscarPorId(id : UUID, tenantId : UUID) : Paciente
  }

  interface PrediccionRepository {
    + guardar(pred : PrediccionDeRiesgo, turnoId : UUID, tenantId : UUID) : void
  }

  interface RecordatorioRepository {
    + guardar(rec : Recordatorio, tenantId : UUID) : void
    + buscarVigente(turnoId : UUID, tenantId : UUID) : Recordatorio
  }

  interface PoliticaRepository {
    + buscarPorProfesional(profId : UUID, tenantId : UUID) : PoliticaDeSobreturnos
  }
}

' =====================================================================
' CAPA INFRASTRUCTURE
' =====================================================================
package "infrastructure" #FFF0F0 {

  class NotificationDispatcher {
    - adapters : List<NotificationPort>
    + enviar(req : NotificationRequest) : NotificationResult
  }

  class TelegramAdapter {
    - botToken : String
    - apiUrl : String
    + enviar(req : NotificationRequest) : NotificationResult
  }

  class EmailAdapter {
    - smtpHost : String
    - fromAddress : String
    + enviar(req : NotificationRequest) : NotificationResult
  }

  class RedisScoreCache {
    - redisTemplate : RedisTemplate
    - defaultTtl : Duration
    + obtener(turnoId : UUID) : Optional<PrediccionDeRiesgo>
    + guardar(turnoId : UUID, pred : PrediccionDeRiesgo, ttl : Duration) : void
  }

  class RecordatorioScheduler <<@Scheduled>> {
    - notificarPrediccionUseCase : NotificarPrediccionUseCase
    - tenantIds : List<UUID>
    + ejecutar() : void
  }

  class TurnoRepositoryJpa {
    - em : EntityManager
    + buscarPorId(id : UUID, tenantId : UUID) : Turno
    + guardar(turno : Turno, tenantId : UUID) : void
    + buscarProximos(ventana : Duration, tenantId : UUID) : List<Turno>
    + contarSobreturnos(profId : UUID, semana : String, tenantId : UUID) : int
  }
}

' =====================================================================
' Asociaciones de dominio
' =====================================================================
Turno ..> EstadoTurno
ConsultaMedica ..> EstadoConsulta
FranjaHoraria ..> EstadoFranja
Recordatorio ..> Canal
Recordatorio ..> EstadoEnvio
PrediccionDeRiesgo ..> Confianza
Sobreturno --|> Turno

Profesional "1" -- "0..*" Agenda
Agenda "1" o-- "1..*" FranjaHoraria
FranjaHoraria "1" -- "0..*" Turno
Paciente "1" -- "0..*" Turno
Profesional "1" -- "0..*" Turno
Profesional "1" -- "0..1" PoliticaDeSobreturnos

Turno "1" -- "0..*" ConsultaMedica
ConsultaMedica "1" *-- "0..1" NotaSOAP
ConsultaMedica "1" -- "0..*" Observacion

Paciente "1" -- "0..*" Cobertura
ObraSocial "1" -- "0..*" Cobertura
Turno "0..*" -- "0..1" Cobertura

Turno "1" -- "0..*" PrediccionDeRiesgo
Turno "1" -- "0..*" Recordatorio

' =====================================================================
' Dependencias entre capas
' =====================================================================

' Realización de interfaces
ReservarTurnoUseCaseImpl ..|> ReservarTurnoUseCase
SugerirSobreturnoUseCaseImpl ..|> SugerirSobreturnoUseCase
GestionarConsultaUseCaseImpl ..|> GestionarConsultaUseCase
NotificarPrediccionUseCaseImpl ..|> NotificarPrediccionUseCase
RegistrarRespuestaUseCaseImpl ..|> RegistrarRespuestaUseCase

NotificationDispatcher ..|> NotificationPort
TelegramAdapter ..|> NotificationPort
EmailAdapter ..|> NotificationPort
RedisScoreCache ..|> ScoreCachePort
TurnoRepositoryJpa ..|> TurnoRepository

' api → application
AgendaController ..> ReservarTurnoUseCase
AgendaController ..> SugerirSobreturnoUseCase
ConsultaController ..> GestionarConsultaUseCase
TelegramWebhookController ..> RegistrarRespuestaUseCase

' application → application
ReservarTurnoUseCaseImpl ..> DisponibilidadService
ReservarTurnoUseCaseImpl ..> CoberturaService
ReservarTurnoUseCaseImpl ..> MotorRiesgoNoShowService
ReservarTurnoUseCaseImpl ..> SugerirSobreturnoUseCase
NotificarPrediccionUseCaseImpl ..> MotorRiesgoNoShowService
NotificarPrediccionUseCaseImpl ..> NotificationPort
MotorRiesgoNoShowService ..> ScoreCachePort

' application → domain (repositorios)
ReservarTurnoUseCaseImpl ..> TurnoRepository
ReservarTurnoUseCaseImpl ..> PrediccionRepository
DisponibilidadService ..> FranjaHorariaRepository
CoberturaService ..> CoberturaRepository
MotorRiesgoNoShowService ..> TurnoRepository
GestionarConsultaUseCaseImpl ..> ConsultaMedicaRepository
GestionarConsultaUseCaseImpl ..> TurnoRepository
GestionarConsultaUseCaseImpl ..> PacienteRepository
NotificarPrediccionUseCaseImpl ..> TurnoRepository
NotificarPrediccionUseCaseImpl ..> RecordatorioRepository
RegistrarRespuestaUseCaseImpl ..> TurnoRepository
RegistrarRespuestaUseCaseImpl ..> RecordatorioRepository
RegistrarRespuestaUseCaseImpl ..> FranjaHorariaRepository
SugerirSobreturnoUseCaseImpl ..> PoliticaRepository
SugerirSobreturnoUseCaseImpl ..> TurnoRepository
SugerirSobreturnoUseCaseImpl ..> FranjaHorariaRepository

' infrastructure → application/domain
NotificationDispatcher o-- "2..*" NotificationPort
RecordatorioScheduler ..> NotificarPrediccionUseCase

' =====================================================================
note right of NotificationPort
  ADR-013: la aplicación llama al
  puerto sin conocer el canal.
  MVP: Telegram + Email.
  Post-piloto: WhatsApp, SMS.
end note

note right of TurnoRepositoryJpa
  Representa el patrón.
  Las demás interfaces de
  repositorio se implementan
  análogamente en infrastructure.
end note

@enduml

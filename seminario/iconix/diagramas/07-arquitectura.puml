@startuml 07-arquitectura
' =====================================================================
' ClinicaSaaS — Diagrama de Arquitectura (despliegue + componentes)
' Entrega T-020 — deliverable 5 — Seminario de Trabajo Final UAI 2026
'
' Fuentes:
'   - docs/architecture/01-high-level-architecture.md  (autoritativa)
'   - docs/adr/ADR-010-clean-architecture.md   (capas backend)
'   - docs/adr/ADR-013-notification-channels.md (canales Telegram/email)
'   - docs/adr/ADR-006-jwt-authentication.md + ADR-014 (auth two-step)
'   - CLAUDE.md (tabla de capas y estructura del repositorio)
'
' Convenciones:
'   - Flechas sólidas: comunicación en runtime (protocolo etiquetado).
'   - Flechas punteadas dentro del backend: dependencia entre capas
'     (regla de dependencia de Clean Architecture: las capas internas
'     no conocen a las externas; infrastructure IMPLEMENTA interfaces
'     declaradas en domain).
' =====================================================================

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam node {
  BackgroundColor #FDFDFD
  BorderColor #444444
}
skinparam database {
  BackgroundColor #EEF5FF
  BorderColor #444444
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #888888
}
skinparam cloud {
  BackgroundColor #F5F5F5
  BorderColor #888888
}
skinparam note {
  BackgroundColor #FFF8DC
  BorderColor #999999
}

actor "Usuario\n(secretaria / profesional)" as usuario

node "Navegador" as navegador {
  component "SPA Angular 18\nAngular Material · Signals\ncore (auth, guards, interceptores)\nfeatures lazy · layout" as spa
}

node "VPS 4 GB RAM — Docker Compose" as vps {

  node "Nginx\nreverse proxy + terminación SSL\n(puertos 80/443)" as nginx

  node "Frontend\nNginx estático\n(build Angular)" as fe

  node "Backend — Spring Boot 3 · Java 21 (puerto 8080)" as backend {
    package "api\nControllers REST · DTOs\n/api/v1/** · /fhir/R4/**" as api
    package "application\nCasos de uso UC-01..UC-04\n@Transactional · motor heurístico\nno-show / overbooking" as app
    package "domain\nEntidades · Value Objects\ninterfaces de repositorio\n(sin dependencias de Spring)" as dom
    package "infrastructure\nrepos JPA · adaptadores Redis\nadaptadores de notificación" as infra
  }

  database "PostgreSQL 16\n(puerto 5432, no expuesto)\n--\nfhir_resources (JSONB)\nfhir_search_params\ntablas relacionales:\nusers · user_tenants ·\nappointments · refresh_tokens\nmigraciones: Flyway" as pg

  database "Redis 8\n(puerto 6379, no expuesto)\n--\ncache permisos RBAC (TTL 5 min)\nblocklist JTI de JWT\nrate limiting de login\ntope semanal obra social\nscore no-show (TTL 30 min)" as redis
}

cloud "Telegram Bot API\n(MVP — riesgo alto/medio)" as telegram
cloud "Servidor SMTP\n(MVP — todos los riesgos)" as smtp

' ----- Runtime -----
usuario --> spa
spa --> nginx : HTTPS 443\nBearer JWT + X-Tenant-ID
nginx --> fe : HTTP\n(archivos estáticos)
nginx --> api : HTTP 8080\nproxy /api/v1/** y /fhir/R4/**

' ----- Capas Clean Architecture (regla de dependencia) -----
api ..> app : invoca casos de uso
app ..> dom : usa entidades e\ninterfaces de repositorio
infra ..> dom : implementa\ninterfaces de dominio

' ----- Infraestructura externa -----
infra --> pg : JDBC 5432\n(toda query incluye tenant_id)
infra --> redis : RESP 6379
infra --> telegram : HTTPS\n(Bot API)
infra --> smtp : SMTP/TLS

note bottom of backend
  Cadena de filtros Spring Security (antes de los controllers):
  RateLimitFilter → JwtAuthenticationFilter → TenantContextFilter.
  Autenticación JWT stateless con rotación de refresh token
  (ADR-006) y flujo two-step identidad → tenant (ADR-014).
end note

note right of redis
  Redis nunca es almacenamiento
  primario: si no está disponible,
  el sistema cae a PostgreSQL
  y sigue operando.
end note

@enduml

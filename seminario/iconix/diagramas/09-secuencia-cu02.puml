@startuml secuencia_CU02
' =====================================================================
' Diagrama de secuencia ICONIX — CU-02 Gestionar consulta médica
' (SOAP básico)
' Entrega T-020 — deliverable 7 · Seminario de Trabajo Final UAI 2026
'
' Fuentes: seminario/iconix/02-especificacion-casos-de-uso.md → CU-02
'          seminario/iconix/diagramas/04-robustez-cu02.puml
' Asignación de comportamiento (control de robustez → clase.método):
'   «Abrir consulta»                    → GestionarConsultaUseCaseImpl.abrirConsulta()
'   «Crear turno retroactivo (walk-in)» → GestionarConsultaUseCaseImpl.crearConsultaWalkIn()
'   «Registrar notas SOAP»              → GestionarConsultaUseCaseImpl.registrarNotaSoap()
'                                          + ConsultaMedica.documentarSOAP()
'   «Validar y registrar observaciones» → GestionarConsultaUseCaseImpl.registrarObservaciones()
'                                          + Observacion.validarRangoClinico()
'   «Registrar diagnóstico provisorio»  → GestionarConsultaUseCaseImpl.registrarDiagnostico()
'   «Cerrar consulta»                   → GestionarConsultaUseCaseImpl.cerrarConsulta()
'                                          [@Transactional]
'
' Trazabilidad curso básico → mensajes:
'   Paso 1 → Medico -> UI ; CTRL.abrirConsulta ; UC.abrirConsulta ;
'            TREPO.buscarPorId ; TUR.verificarEstadoAtencion ;
'            CONREPO.buscarPorTurno
'   Paso 2 → PREPO.buscarPorId ; retorno «presenta la consulta»
'   Pasos 3–4 → CTRL.registrarNotaSoap ; CON.documentarSOAP ;
'            «create» NotaSOAP ; CONREPO.guardar
'   Pasos 5–6 → CTRL.registrarObservaciones ; «create» Observacion ;
'            OBS.validarRangoClinico ; CON.registrarObservacion ;
'            CONREPO.guardar
'   Paso 7 → (opt) CTRL.registrarDiagnostico ; LLM.sugerirCie10 ;
'            CON.registrarDiagnostico (código validado por médico)
'   Pasos 8–9 → CTRL.cerrarConsulta ; LLM.generarResumen ;
'            médico valida resumen ; CON.finalizar ;
'            TUR.marcarCumplido ; CONREPO/TREPO.guardar (transaccional)
' Cursos alternos: A1 (nota final) · A2 (alt) · A3 (alt, CU-S09)
' Multitenancy (ADR-003): todo método de repositorio recibe tenantId.
' =====================================================================

skinparam shadowing false
skinparam sequenceMessageAlign left
skinparam noteBackgroundColor #FFF8DC

actor "Médico" as Medico
boundary "ConsultaMedicaComponent\n(Angular)" as UI
participant "ConsultaController\n«api»" as CTRL
participant "GestionarConsultaUseCaseImpl\n«application»" as UC
participant "TurnoRepository\n«domain·interface»" as TREPO
participant "ConsultaMedicaRepository\n«domain·interface»" as CONREPO
participant "PacienteRepository\n«domain·interface»" as PREPO
entity "Turno" as TUR
entity "ConsultaMedica" as CON
entity "NotaSOAP" as NOTA
entity "Observacion" as OBS
participant "ClaudeApiClient\n«infrastructure»" as LLM

== Paso 1 ==
Medico -> UI : abre la consulta vinculada al turno
UI -> CTRL : POST /api/v1/consultas\nabrirConsulta(turnoId)
CTRL -> UC : abrirConsulta(turnoId, tenantId)
UC -> TREPO : buscarPorId(turnoId, tenantId)
TREPO --> UC : turno
UC -> TUR : verificarEstadoAtencion()
note right of TUR
  Precondición: turno en estado LLEGO
  (o consulta EN_CURSO a retomar).
end note
TUR --> UC : ok
UC -> CONREPO : buscarPorTurno(turnoId, tenantId)
CONREPO --> UC : consulta (existente o nueva)

alt A3 — paciente sin turno previo (walk-in, CU-S09)
  UI -> CTRL : POST /api/v1/consultas/walk-in\ncrearConsultaWalkIn(pacienteId)
  CTRL -> UC : crearConsultaWalkIn(pacienteId,\nprofesionalId, tenantId)
  UC -> TUR : «create» new Turno(retroactivo,\nestado = LLEGO)
  UC -> CON : «create» new ConsultaMedica(turnoId,\norigen = WALK_IN)
  UC -> TREPO : guardar(turno, tenantId)
  UC -> CONREPO : guardar(consulta, tenantId)
  note over UC, CONREPO
    Mantiene la integridad referencial
    consulta–turno. El flujo continúa
    en el paso 2.
  end note
end

== Paso 2 ==
UC -> PREPO : buscarPorId(pacienteId, tenantId)
PREPO --> UC : paciente
UC --> CTRL : ConsultaAbiertaResponse(paciente, turno)
CTRL --> UI : 200 OK
UI --> Medico : presenta la consulta con datos\ndel paciente y del turno

== Pasos 3–4 — notas SOAP ==
Medico -> UI : registra notas SOAP\n(Subjetivo, Objetivo, Análisis, Plan)
UI -> CTRL : PUT /api/v1/consultas/{id}/soap\nregistrarNotaSoap(dto)
CTRL -> UC : registrarNotaSoap(consultaId, nota, tenantId)
UC -> NOTA : «create» new NotaSOAP(subjetivo,\nobjetivo, analisis, plan)
UC -> CON : documentarSOAP(nota)
UC -> CONREPO : guardar(consulta, tenantId)
CONREPO --> UC : ok
UC --> CTRL : 200 OK
CTRL --> UI : notas persistidas

== Pasos 5–6 — signos vitales y mediciones ==
Medico -> UI : registra signos vitales\n(TA, FC, peso, talla, glucemia)
UI -> CTRL : POST /api/v1/consultas/{id}/observaciones\nregistrarObservaciones(dto)
CTRL -> UC : registrarObservaciones(consultaId,\nmediciones, tenantId)
UC -> OBS : «create» new Observacion(codigo,\nvalor, unidad)
UC -> OBS : validarRangoClinico()
OBS --> UC : advertencias (puede ser vacía)

alt A2 — valores clínicos fuera de rango
  UC --> CTRL : 200 OK + advertencias
  CTRL --> UI : advierte rangos imposibles\n(no bloquea el registro)
end

UC -> CON : registrarObservacion(observacion)
UC -> CONREPO : guardar(consulta, tenantId)
CONREPO --> UC : ok
UC --> CTRL : 200 OK
CTRL --> UI : observaciones almacenadas

== Paso 7 (opcional) ==
opt el médico registra diagnóstico provisorio
  Medico -> UI : escribe el diagnóstico\ncomo descripción libre
  UI -> CTRL : PUT /api/v1/consultas/{id}/diagnostico\nregistrarDiagnostico(dto)
  CTRL -> UC : registrarDiagnostico(consultaId,\ntexto, tenantId)
  UC -> LLM : sugerirCie10(texto)
  note right of LLM
    ADR-012 / T-018 — Claude API.
    Latencia objetivo: < 3 s.
  end note
  LLM --> UC : SugerenciaCie10(codigo, justificacion)
  UC --> CTRL : 200 OK + sugerencia CIE-10
  CTRL --> UI : código + justificación para validación
  UI --> Medico : muestra sugerencia CIE-10
  Medico -> UI : confirma o edita el código
  UI -> CTRL : PUT confirmar diagnóstico (codigoFinal)
  CTRL -> UC : confirmarDiagnostico(consultaId, codigoFinal, tenantId)
  UC -> CON : registrarDiagnostico(codigoFinal)
  UC -> CONREPO : guardar(consulta, tenantId)
  note over UC, CON
    El médico conserva el criterio final.
    El código CIE-10 validado queda en ConsultaMedica.
  end note
end

== Pasos 8–9 — cierre transaccional (@Transactional) ==
Medico -> UI : cierra la consulta
UI -> CTRL : POST /api/v1/consultas/{id}/cierre\ncerrarConsulta()
CTRL -> UC : cerrarConsulta(consultaId, tenantId)
UC -> LLM : generarResumen(encounter FHIR)
note right of LLM
  ADR-012 / T-017 — Claude API.
  Latencia objetivo: < 3 s.
end note
LLM --> UC : resumen en lenguaje natural
UC --> CTRL : ResumenEncounterResponse(resumen)
CTRL --> UI : resumen para validación del médico
UI --> Medico : presenta resumen para validar
Medico -> UI : valida el resumen
UI -> CTRL : POST confirmar cierre (resumenValidado)
CTRL -> UC : confirmarCierre(consultaId, resumenValidado, tenantId)
UC -> CON : finalizar(resumenValidado)
note right of CON
  Estado FINALIZADA + fecha de cierre + resumen.
end note
UC -> TUR : marcarCumplido()
UC -> CONREPO : guardar(consulta, tenantId)
UC -> TREPO : guardar(turno, tenantId)
UC --> CTRL : ConsultaCerradaResponse
CTRL --> UI : 200 OK
UI --> Medico : consulta cerrada

note over UC, TREPO
  Paso 9: cierre persistido en una única transacción.
  Dos máquinas de estado separadas (ADR-016):
  · Turno (Appointment): RESERVADO → CONFIRMADO →
    LLEGO → CUMPLIDO / AUSENTE.
  · ConsultaMedica (Encounter): EN_CURSO → FINALIZADA.
  A1 — abandono sin cerrar: la consulta queda
  EN_CURSO y el sistema notifica al médico en su
  próxima sesión.
end note

@enduml
